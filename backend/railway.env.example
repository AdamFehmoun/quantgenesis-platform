# =====================================================================
# QuantGenesis backend — Railway environment variables
# Copy these into the Railway dashboard (Service → Variables).
# Do NOT commit a filled-in copy of this file.
# =====================================================================

# --- Database ---------------------------------------------------------
# Provided automatically by Railway's PostgreSQL plugin (reference it as
# ${{ Postgres.DATABASE_URL }} when adding it to this service).
# Railway emits `postgresql://...`; the app rewrites it to
# `postgresql+psycopg://...` at boot so SQLAlchemy uses psycopg v3.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# --- Cache ------------------------------------------------------------
# Provided automatically by Railway's Redis plugin (reference it as
# ${{ Redis.REDIS_URL }}). Optional — endpoints that don't need cache
# still work without it.
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# --- LLM / agents -----------------------------------------------------
# Required by the agents pipeline (Anthropic Claude API).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Sandbox executor (E2B) -------------------------------------------
# Required by /api/pipeline/run to dispatch generated code to the
# sandbox for backtesting.
E2B_API_KEY=e2b_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Market data ------------------------------------------------------
# Required only if the FMP-backed data routes are used.
FMP_API_KEY=fmp_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Agents repo location --------------------------------------------
# Path inside the container where the quantgenesis-agents code lives.
# Locally we bind-mount it (see docker-compose.yml). On Railway, either
# vendor the agents repo into the image or leave unset and accept that
# /api/pipeline/run returns 503 until the agents repo is wired in.
# AGENTS_PATH=/agents

# --- Server -----------------------------------------------------------
# PORT is injected automatically by Railway. Do NOT set it manually.
# PORT=8000
