# ══════════════════════════════════════════
# QuantGenesis Platform — Variables d'environnement
# Copier en .env et remplir les valeurs
# JAMAIS commiter le .env
# Utiliser Infisical en équipe
# ══════════════════════════════════════════

# ── IA ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...

# ── Données financières ───────────────────
FMP_API_KEY=...
ALPACA_KEY=...
ALPACA_SECRET=...
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Infrastructure ────────────────────────
E2B_API_KEY=...
DATABASE_URL=postgresql://user:password@localhost:5432/quantgenesis
REDIS_URL=redis://localhost:6379

# ── Backend ───────────────────────────────
BACKEND_PORT=8000
SECRET_KEY=change-this-in-production
ENVIRONMENT=development

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
